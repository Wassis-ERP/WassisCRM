# URL do WAssisBE usada pelos helpers de sessao e pelos novos contratos HTTP.
VITE_API_BASE_URL=https://localhost:54269

# Use "backend" em homologacao/producao para exigir login real.
# Em branco, o CRM segue com usuario mock para desenvolvimento incremental.
VITE_AUTH_MODE=

# Use "backend" para persistir segurados e oportunidades no WAssisBE.
# Os demais modulos continuam no armazenamento local ate terem contrato dedicado.
VITE_DATA_MODE=memory

# Minutos sem atividade local antes de limpar a sessao do backend.
VITE_BACKEND_IDLE_TIMEOUT_MINUTES=120
